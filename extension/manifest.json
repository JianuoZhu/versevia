{
  "manifest_version": 3,
  "name": "Sentence · Bilingual YouTube",
  "icons": {
    "16": "icons/sentence-16.png",
    "32": "icons/sentence-32.png",
    "48": "icons/sentence-48.png",
    "128": "icons/sentence-128.png"
  },
  "version": "1.5.3",
  "description": "Read and navigate YouTube by sentence, with your choice of translation and speech recognition providers.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/sentence-16.png",
      "32": "icons/sentence-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Sentence subtitles"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "sabr-page.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "bootstrap.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "core.js",
        "appearance.js",
        "style-prefs.js",
        "catalog.js",
        "translation-batch.js",
        "semantic.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
